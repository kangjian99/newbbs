# 运行时连接（Neon 请填 pooled / pooler 主机）
DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# 迁移用直连（Neon 非 pooler 主机）。不填则迁移也走 DATABASE_URL
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require

# 会话无状态签名不依赖此值；留空即可。生产环境建议设成长随机串，供日后扩展。
AUTH_SECRET=

# 用这个邮箱注册（或之后登录）的账号会成为管理员。不要提交真实邮箱到仓库。
ADMIN_EMAIL=

# 空库是否写入演示版块和账号。不填时开发模式写入、生产模式不写入。
SEED_DEMO=
